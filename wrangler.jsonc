
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frankdev-xxxcore-server",
  "main": "index.ts",
  "compatibility_date": "2026-11-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xxxcore-database",
      "database_id": "220a228e-33f2-41e1-abbe-5187ad15c9fa"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
